# ============================================================
# SismoWatch - Variables de entorno (plantilla)
# Copia este archivo a .env y rellena los valores.
#   cp .env.example .env
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# --- PostgreSQL (serving + metastore de Airflow) ---
POSTGRES_DB=sismowatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_postgres_password_aqui
# Puerto del host (5432 lo usa el Postgres del sistema; 5433/5434 otros servicios)
POSTGRES_PORT=5435

# Credenciales de los roles de BD (mínimo privilegio)
SISMO_PG_PASSWORD_INGEST=CAMBIAR_ingest
SISMO_PG_PASSWORD_TRANSFORM=CAMBIAR_transform
SISMO_PG_PASSWORD_READER=CAMBIAR_reader
SISMO_PG_PASSWORD_ADMIN=CAMBIAR_admin

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=CAMBIAR_airflow_password_aqui
# Genera una clave Fernet propia:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=CAMBIAR_con_clave_fernet_generada
AIRFLOW__CORE__LOAD_EXAMPLES=False
# Webhook de alertas ante fallos de DAG (Slack/Telegram/HTTP cualquiera)
AIRFLOW_ALERT_WEBHOOK_URL=

# --- Plataforma (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=CAMBIAR_jwt_secret_aqui
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Usuarios sembrados de la plataforma (roles viewer/admin)
ADMIN_EMAIL=admin@sismowatch.local
ADMIN_PASSWORD=CAMBIAR_admin_plataforma_password
ADMIN_USERNAME=admin
VIEWER_EMAIL=viewer@sismowatch.local
VIEWER_PASSWORD=CAMBIAR_viewer_plataforma_password
VIEWER_USERNAME=viewer

# --- Frontend (React) ---
VITE_API_URL=http://localhost:8010

# --- Ollama (IA local en el host) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120

# --- MinIO (lakehouse: bronze / silver / gold) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CAMBIAR_minio_password
MINIO_SECURE=0

# --- Spark standalone ---
SPARK_MASTER_URL=spark://spark-master:7077

# --- OpenMetadata ---
# Credenciales de la BD interna de OpenMetadata (MySQL)
OM_MYSQL_ROOT_PASSWORD=CAMBIAR_om_mysql_root
OM_MYSQL_PASSWORD=CAMBIAR_om_mysql_user
# Usuario admin del UI de OpenMetadata (creado en el primer arranque)
OM_USERNAME=admin@open-metadata.org
OM_PASSWORD=CAMBIAR_om_admin
